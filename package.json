{
  "name": "spaceherd",
  "version": "0.1.6",
  "private": true,
  "description": "herdr on the left, VS Code on the right, switching together",
  "license": "MIT",
  "main": "src/main/main.js",
  "desktopName": "spaceherd.desktop",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/postinstall.js",
    "dist": "electron-builder --publish never",
    "icon": "electron scripts/render-icon.js"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "jsonc-parser": "3.3.1",
    "node-pty": "1.1.0"
  },
  "allowScripts": {
    "electron@44.9.3": true,
    "node-pty@1.1.0": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sebastian-ruiz/spaceherd.git"
  },
  "author": "Sebastian Ruiz <me@sruiz.uk>",
  "homepage": "https://github.com/sebastian-ruiz/spaceherd",
  "build": {
    "appId": "io.github.sebastian-ruiz.spaceherd",
    "productName": "Spaceherd",
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json",
      "LICENSE"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "sebastian-ruiz",
      "repo": "spaceherd",
      "releaseType": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false
    },
    "linux": {
      "category": "Development",
      "icon": "build/icons",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "maintainer": "Sebastian Ruiz <me@sruiz.uk>"
    }
  }
}
